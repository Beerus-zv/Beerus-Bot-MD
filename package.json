{
  "name": "beerus-bot-md",
  "version": "2.6.0",
  "description": "Beerus Bot MD - Bot de WhatsApp multi-dispositivo con Baileys",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning iniciar.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch index.js",
    "verify": "node --disable-warning=ExperimentalWarning verify.mjs",
    "check": "node --check index.js && node --check lib/loader.js && node --check database/db.js",
    "test": "node verify.mjs",
    "cartas": "node scripts/refrescar-cartas.mjs",
    "banners": "node scripts/renovar-banners.mjs",
    "rarezas": "node scripts/sincronizar-rarezas.mjs",
    "graphify": "node scripts/graphify.mjs",
    "postinstall": "node scripts/parche-baileys.mjs",
    "diag": "node --disable-warning=ExperimentalWarning scripts/diagnostico-vinculacion.mjs"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "beerus"
  ],
  "author": "Beerus_zv",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "audio-decode": "^2.2.3",
    "cheerio": "^1.2.0",
    "link-preview-js": "^3.2.0",
    "node-fetch": "^3.3.2",
    "node-gtts": "^2.0.2",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "yt-dlp-wrap": "^2.3.12"
  }
}
